# Copy this file to demo/server/.env and fill in what you need.
# Nothing here ever reaches the browser. The server reads it, uses it, and
# /api/llm/status returns only whether a key is configured and which model
# would run. Not the key, not a prefix of it, not its length.

# ----------------------------------------------------------------- the model
# Leave LLM_API_KEY blank and the product still runs. Screening evaluations
# fall back to a deterministic match against the phrase bank the customer owns,
# and every screen that shows one prints "No model ran."

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# Optional. For an OpenAI-compatible endpoint set LLM_PROVIDER=openai and point
# LLM_BASE_URL at it.
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_TIMEOUT_MS=45000
# LLM_MAX_TOKENS=2000

# ------------------------------------------------------------------- server
# PORT=4173
# HOST=127.0.0.1

# Where the database file lives. Delete it, or press R in the interface, to
# reseed from scratch.
# DEMO_DB_FILE=./server/data/state.json

# Set to 1 to force a reseed on the next boot.
# RESEED=0

# Seeded screening evaluations use the deterministic rubric so a fresh boot
# costs nothing and produces the same result every time. Set to 1 to seed with
# the model instead, which will make around thirty model calls at boot.
# SEED_USE_LLM=0
