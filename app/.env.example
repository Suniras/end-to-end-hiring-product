# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# THE VOICE TRANSPORT. With all four set, the product places real agentX calls
# and says so. With any one missing it resolves to simulated, stamps every call
# stage simulated, and prints why. There is no third state and nothing can
# describe a simulated call as a real one.
#
# The base defaults to external-proxy-us, which is the host that answers.
# agentx-us resolves but every one of its IPs TCP times out from this network.
AGENTX_BASE=https://external-proxy-us.nurixlabs.tech
AGENTX_WORKSPACE_ID=
AGENTX_AGENT_ID=
AGENTX_USER_EMAIL=
AGENTX_USER_ID=

# THE MODEL, for the screening evaluation. With no key the product runs on the
# deterministic phrase rubric and prints "No model ran" on every screen that
# shows an evaluation. A fallback is never described as a model.
LLM_API_KEY=
LLM_MODEL=

# REAL EMAIL. With no key, an email is recorded as a communication and marked
# simulated rather than sent.
RESEND_API_KEY=
EMAIL_FROM=

PORT=4173
